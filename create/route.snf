# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-route-transact-sql?view=sql-server-ver17

CREATE ROUTE name [ AUTHORIZATION owner ]
    WITH [ SERVICE_NAME = 'service' , ]
    [ BROKER_INSTANCE = 'broker_instance' , ]
    [ LIFETIME = lifetime , ]
    ADDRESS = 'address'
    [ , MIRROR_ADDRESS = 'mirror_address' ]
