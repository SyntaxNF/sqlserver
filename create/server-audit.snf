# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-server-audit-transact-sql?view=sql-server-ver17

CREATE SERVER AUDIT name
    TO audit_target
    [ WITH ( server_audit_option [, ...] ) ]
    [ WHERE audit_predicate_expression ]

# PARTOFIS audit_target
FILE (
    FILEPATH = 'file_path'
    [ , MAXSIZE = { size_value { MB | GB | TB } | UNLIMITED } ]
    [ , { MAX_ROLLOVER_FILES = { file_count | UNLIMITED } | MAX_FILES = file_count } ]
    [ , RESERVE_DISK_SPACE = { ON | OFF } ]
)

{ APPLICATION_LOG | SECURITY_LOG }

# ONEOFIS server_audit_option
QUEUE_DELAY = queue_delay_value
ON_FAILURE = { CONTINUE | SHUTDOWN | FAIL_OPERATION }
AUDIT_GUID = 'audit_guid'
