# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-column-master-key-transact-sql?view=sql-server-ver17

# CASE COLUMN_MASTER_KEY
CREATE COLUMN MASTER KEY name
    WITH (
        KEY_STORE_PROVIDER_NAME = 'key_store_provider_name',
        KEY_PATH = 'key_path'
        [ , ENCLAVE_COMPUTATIONS ( SIGNATURE = signature_binary ) ]
    )
