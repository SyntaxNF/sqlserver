# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-event-notification-transact-sql?view=sql-server-ver17

CREATE EVENT NOTIFICATION name
    ON { SERVER | DATABASE | QUEUE queue }
    [ WITH FAN_IN ]
    FOR event_type_or_group [, ...]
    TO SERVICE 'broker_service' , { 'broker_instance' | 'current database' }
