# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-queue-transact-sql?view=sql-server-ver17

CREATE QUEUE name
    [ WITH queue_option [, ...] ]
    [ ON { filegroup | \[DEFAULT\] } ]

# ONEOFIS queue_option
STATUS = { ON | OFF }
RETENTION = { ON | OFF }
ACTIVATION ( [ STATUS = { ON | OFF } , ] PROCEDURE_NAME = procedure , MAX_QUEUE_READERS = max_readers , EXECUTE AS { SELF | 'user' | OWNER } )
POISON_MESSAGE_HANDLING ( [ STATUS = { ON | OFF } ] )
