# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-external-resource-pool-transact-sql?view=sql-server-ver17

CREATE EXTERNAL RESOURCE POOL name [ WITH ( pool_option [, ...] ) ]

# ONEOFIS pool_option
MAX_CPU_PERCENT = percentage
AFFINITY { CPU = { AUTO | ( id_range [, ...] ) } | NUMANODE = ( id_range [, ...] ) }
MAX_MEMORY_PERCENT = percentage
MAX_PROCESSES = process_count

# WHERE id_range
first_id [ TO last_id ]
