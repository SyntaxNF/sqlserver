# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-fulltext-catalog-transact-sql?view=sql-server-ver17

# CASE FULLTEXT_CATALOG
CREATE FULLTEXT CATALOG name
    [ ON FILEGROUP filegroup ]
    [ IN PATH 'root_path' ]
    [ WITH ACCENT_SENSITIVITY = { ON | OFF } ]
    [ AS DEFAULT ]
    [ AUTHORIZATION owner ]
