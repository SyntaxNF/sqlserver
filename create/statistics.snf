# https://learn.microsoft.com/en-us/sql/t-sql/statements/create-statistics-transact-sql?view=sql-server-ver17

# CASE STATISTICS
CREATE STATISTICS name
    ON table ( colname [, ...] )
    [ WHERE filter_expression ]
    [ WITH statistics_option [, ...] ]

# ONEOFIS statistics_option
FULLSCAN [ , PERSIST_SAMPLE_PERCENT = { ON | OFF } ]
SAMPLE sample_value { PERCENT | ROWS } [ , PERSIST_SAMPLE_PERCENT = { ON | OFF } ]
NORECOMPUTE
INCREMENTAL = { ON | OFF }
MAXDOP = maxdop_value
AUTO_DROP = { ON | OFF }
