# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-symmetric-key-transact-sql?view=sql-server-ver17

# CASE ADD_ENCRYPTION
ALTER SYMMETRIC KEY name ADD ENCRYPTION BY key_encryptor [, ...]

# CASE DROP_ENCRYPTION
ALTER SYMMETRIC KEY name DROP ENCRYPTION BY key_encryptor [, ...]


# ONEOFIS key_encryptor
CERTIFICATE certificate_name
PASSWORD = 'password'
SYMMETRIC KEY symmetric_key_name
ASYMMETRIC KEY asymmetric_key_name
