# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-service-master-key-transact-sql?view=sql-server-ver17

# CASE REGENERATE
ALTER SERVICE MASTER KEY [ FORCE ] REGENERATE

# CASE RECOVER_OLD_ACCOUNT
ALTER SERVICE MASTER KEY WITH OLD_ACCOUNT = 'account_name', OLD_PASSWORD = 'password'

# CASE RECOVER_NEW_ACCOUNT
ALTER SERVICE MASTER KEY WITH NEW_ACCOUNT = 'account_name', NEW_PASSWORD = 'password'
