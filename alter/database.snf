# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-database-transact-sql?view=sql-server-ver17

# CASE RENAME
ALTER DATABASE { name | CURRENT } MODIFY NAME = new_name

# CASE COLLATE
ALTER DATABASE { name | CURRENT } COLLATE collation

# CASE ADD_FILE
ALTER DATABASE name ADD FILE file_definition [, ...] [ TO FILEGROUP filegroup ]

# CASE ADD_LOG_FILE
ALTER DATABASE name ADD LOG FILE file_definition [, ...]

# CASE REMOVE_FILE
ALTER DATABASE name REMOVE FILE logical_file

# CASE MODIFY_FILE
ALTER DATABASE name MODIFY FILE (
    NAME = logical_file
    [ , NEWNAME = new_logical_file ]
    [ , FILENAME = 'file_path' ]
    [ , SIZE = file_size [ KB | MB | GB | TB ] ]
    [ , MAXSIZE = { max_size [ KB | MB | GB | TB ] | UNLIMITED } ]
    [ , FILEGROWTH = growth [ KB | MB | GB | TB | % ] ]
    [ , OFFLINE ]
)

# CASE ADD_FILEGROUP
ALTER DATABASE name ADD FILEGROUP filegroup [ CONTAINS FILESTREAM | CONTAINS MEMORY_OPTIMIZED_DATA ]

# CASE REMOVE_FILEGROUP
ALTER DATABASE name REMOVE FILEGROUP filegroup

# CASE MODIFY_FILEGROUP
ALTER DATABASE name MODIFY FILEGROUP filegroup
    { READONLY | READWRITE | READ_ONLY | READ_WRITE | DEFAULT | NAME = new_filegroup | AUTOGROW_SINGLE_FILE | AUTOGROW_ALL_FILES }

# CASE SET
ALTER DATABASE { name | CURRENT } SET database_option [, ...] [ WITH termination_clause ]

# CASE HADR
ALTER DATABASE name SET HADR { AVAILABILITY GROUP = availability_group | OFF | SUSPEND | RESUME }

# CASE PARTNER
ALTER DATABASE name SET PARTNER
    { = 'partner_server' | FAILOVER | FORCE_SERVICE_ALLOW_DATA_LOSS | OFF | RESUME | SAFETY { FULL | OFF } | SUSPEND | TIMEOUT seconds }

# CASE WITNESS
ALTER DATABASE name SET WITNESS { = 'witness_server' | OFF }

# WHERE termination_clause
{ ROLLBACK AFTER seconds [ SECONDS ] | ROLLBACK IMMEDIATE | NO_WAIT }

# ONEOFIS database_option
AUTO_CLOSE { ON | OFF }
AUTO_CREATE_STATISTICS { OFF | ON [ ( INCREMENTAL = { ON | OFF } ) ] }
AUTO_SHRINK { ON | OFF }
AUTO_UPDATE_STATISTICS { ON | OFF }
AUTO_UPDATE_STATISTICS_ASYNC { ON | OFF }
AUTOMATIC_TUNING ( FORCE_LAST_GOOD_PLAN = { DEFAULT | ON | OFF } )
CHANGE_TRACKING { = OFF | = ON [ ( change_tracking_option [, ...] ) ] | ( change_tracking_option [, ...] ) }
CONTAINMENT = { NONE | PARTIAL }
CURSOR_CLOSE_ON_COMMIT { ON | OFF }
CURSOR_DEFAULT { LOCAL | GLOBAL }
DATE_CORRELATION_OPTIMIZATION { ON | OFF }
ENCRYPTION { ON | OFF | SUSPEND | RESUME }
{ ONLINE | OFFLINE | EMERGENCY }
{ READ_ONLY | READ_WRITE }
{ SINGLE_USER | RESTRICTED_USER | MULTI_USER }
DELAYED_DURABILITY = { DISABLED | ALLOWED | FORCED }
DB_CHAINING { ON | OFF }
TRUSTWORTHY { ON | OFF }
DEFAULT_FULLTEXT_LANGUAGE = language_value
DEFAULT_LANGUAGE = language_value
NESTED_TRIGGERS = { OFF | ON }
TRANSFORM_NOISE_WORDS = { OFF | ON }
TWO_DIGIT_YEAR_CUTOFF = year
FILESTREAM ( filestream_option [, ...] )
MIXED_PAGE_ALLOCATION { OFF | ON }
PARAMETERIZATION { SIMPLE | FORCED }
QUERY_STORE { = OFF [ ( FORCED ) ] | = ON [ ( query_store_option [, ...] ) ] | ( query_store_option [, ...] ) | CLEAR [ ALL ] }
RECOVERY { FULL | BULK_LOGGED | SIMPLE }
TORN_PAGE_DETECTION { ON | OFF }
PAGE_VERIFY { CHECKSUM | TORN_PAGE_DETECTION | NONE }
PERSISTENT_LOG_BUFFER = { ON ( DIRECTORY_NAME = 'directory_path' ) | OFF }
{ ENABLE_BROKER | DISABLE_BROKER | NEW_BROKER | ERROR_BROKER_CONVERSATIONS }
HONOR_BROKER_PRIORITY { ON | OFF }
ALLOW_SNAPSHOT_ISOLATION { ON | OFF }
READ_COMMITTED_SNAPSHOT { ON | OFF }
MEMORY_OPTIMIZED_ELEVATE_TO_SNAPSHOT = { ON | OFF }
{ ANSI_NULL_DEFAULT | ANSI_NULLS | ANSI_PADDING | ANSI_WARNINGS | ARITHABORT | CONCAT_NULL_YIELDS_NULL | NUMERIC_ROUNDABORT | QUOTED_IDENTIFIER | RECURSIVE_TRIGGERS } { ON | OFF }
COMPATIBILITY_LEVEL = { 170 | 160 | 150 | 140 | 130 | 120 | 110 | 100 }
TARGET_RECOVERY_TIME = duration { SECONDS | MINUTES }
TEMPORAL_HISTORY_RETENTION { ON | OFF }
ACCELERATED_DATABASE_RECOVERY = { ON | OFF } [ ( PERSISTENT_VERSION_STORE_FILEGROUP = filegroup ) ]
OPTIMIZED_LOCKING = { ON | OFF }
SUSPEND_FOR_SNAPSHOT_BACKUP = { ON | OFF } [ ( MODE = COPY_ONLY ) ]

# ONEOFIS filestream_option
NON_TRANSACTED_ACCESS = { OFF | READ_ONLY | FULL }
DIRECTORY_NAME = 'directory_name'

# ONEOFIS change_tracking_option
AUTO_CLEANUP = { ON | OFF }
CHANGE_RETENTION = retention { DAYS | HOURS | MINUTES }

# ONEOFIS query_store_option
OPERATION_MODE = { READ_WRITE | READ_ONLY }
CLEANUP_POLICY = ( STALE_QUERY_THRESHOLD_DAYS = days )
DATA_FLUSH_INTERVAL_SECONDS = seconds
MAX_STORAGE_SIZE_MB = megabytes
INTERVAL_LENGTH_MINUTES = minutes
SIZE_BASED_CLEANUP_MODE = { AUTO | OFF }
QUERY_CAPTURE_MODE = { ALL | AUTO | CUSTOM | NONE }
MAX_PLANS_PER_QUERY = plan_count
WAIT_STATS_CAPTURE_MODE = { ON | OFF }
QUERY_CAPTURE_POLICY = ( query_capture_option [, ...] )

# ONEOFIS query_capture_option
STALE_CAPTURE_POLICY_THRESHOLD = duration { DAYS | HOURS }
EXECUTION_COUNT = execution_count
TOTAL_COMPILE_CPU_TIME_MS = milliseconds
TOTAL_EXECUTION_CPU_TIME_MS = milliseconds


# WHERE file_definition
( NAME = logical_file , FILENAME = 'file_path'
    [ , SIZE = file_size [ KB | MB | GB | TB ] ]
    [ , MAXSIZE = { max_size [ KB | MB | GB | TB ] | UNLIMITED } ]
    [ , FILEGROWTH = growth [ KB | MB | GB | TB | % ] ]
)
