# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-server-configuration-transact-sql?view=sql-server-ver17

# CASE PROCESS_AFFINITY
ALTER SERVER CONFIGURATION SET PROCESS AFFINITY { CPU = { AUTO | id_range [, ...] } | NUMANODE = id_range [, ...] }

# CASE DIAGNOSTIC_LOG
ALTER SERVER CONFIGURATION SET DIAGNOSTICS LOG
    { ON | OFF | PATH = { 'file_path' | DEFAULT } | MAX_SIZE = { 'megabytes' MB | DEFAULT } | MAX_FILES = { 'file_count' | DEFAULT } }

# CASE FAILOVER_CLUSTER
ALTER SERVER CONFIGURATION SET FAILOVER CLUSTER PROPERTY cluster_property

# CASE HADR_CONTEXT
ALTER SERVER CONFIGURATION SET HADR CLUSTER CONTEXT = { 'windows_cluster' | LOCAL }

# CASE BUFFER_POOL_EXTENSION
ALTER SERVER CONFIGURATION SET BUFFER POOL EXTENSION
    { ON ( FILENAME = 'file_path' , SIZE = memory_size [ KB | MB | GB ] ) | OFF }

# CASE SOFTNUMA
ALTER SERVER CONFIGURATION SET SOFTNUMA { ON | OFF }

# CASE MEMORY_OPTIMIZED
ALTER SERVER CONFIGURATION SET MEMORY_OPTIMIZED
    { ON | OFF | TEMPDB_METADATA = { ON [ ( RESOURCE_POOL = 'pool' ) ] | OFF } | HYBRID_BUFFER_POOL = { ON | OFF } }

# CASE HARDWARE_OFFLOAD
ALTER SERVER CONFIGURATION SET HARDWARE_OFFLOAD { ON | OFF }

# CASE SNAPSHOT_BACKUP
ALTER SERVER CONFIGURATION SET SUSPEND_FOR_SNAPSHOT_BACKUP = { ON | OFF }
    [ ( { GROUP = ( database [, ...] ) [ , MODE = COPY_ONLY ] | MODE = COPY_ONLY } ) ]

# WHERE id_range
first_id [ TO last_id ]

# ONEOFIS cluster_property
VERBOSELOGGING = { 'logging_detail' | DEFAULT }
SQLDUMPERDUMPFLAGS = { 'dump_flags' | DEFAULT }
SQLDUMPERDUMPPATH = { 'file_path' | DEFAULT }
SQLDUMPERDUMPTIMEOUT = { 'timeout' | DEFAULT }
FAILURECONDITIONLEVEL = { 'condition_level' | DEFAULT }
HEALTHCHECKTIMEOUT = { 'timeout' | DEFAULT }
CLUSTERCONNECTIONOPTIONS = 'connection_options'
