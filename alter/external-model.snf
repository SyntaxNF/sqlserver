# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-external-model-transact-sql?view=sql-server-ver17

# CASE REMOTE_EMBEDDING_MODEL
ALTER EXTERNAL MODEL name SET ( external_model_option [, ...] )

# ONEOFIS external_model_option
LOCATION = 'https_location'
API_FORMAT = { 'OpenAI' | 'Azure OpenAI' | 'Ollama' }
MODEL_TYPE = EMBEDDINGS
MODEL = 'model_name'
CREDENTIAL = credential
PARAMETERS = 'json_parameters'
