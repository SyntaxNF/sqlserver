# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-external-language-transact-sql?view=sql-server-ver17

# CASE SET_OR_ADD
ALTER EXTERNAL LANGUAGE name [ AUTHORIZATION owner ]
    { SET | ADD } language_file_definition

# CASE REMOVE
ALTER EXTERNAL LANGUAGE name [ AUTHORIZATION owner ] REMOVE PLATFORM { WINDOWS | LINUX }

# WHERE language_file_definition
( CONTENT = file_or_binary_expression, FILE_NAME = 'file_name'
    [ , PLATFORM = { WINDOWS | LINUX } ] )
