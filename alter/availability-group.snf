# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-availability-group-transact-sql?view=sql-server-ver17

# CASE SET
ALTER AVAILABILITY GROUP name SET ( availability_option )

# CASE ADD_DATABASE
ALTER AVAILABILITY GROUP name ADD DATABASE database

# CASE REMOVE_DATABASE
ALTER AVAILABILITY GROUP name REMOVE DATABASE database

# CASE ADD_REPLICA
ALTER AVAILABILITY GROUP name ADD REPLICA ON replica_definition

# CASE MODIFY_REPLICA
ALTER AVAILABILITY GROUP name MODIFY REPLICA ON 'server_instance' WITH ( replica_modify_option )

# CASE REMOVE_REPLICA
ALTER AVAILABILITY GROUP name REMOVE REPLICA ON 'server_instance'

# CASE JOIN
ALTER AVAILABILITY GROUP name JOIN [ WITH ( CLUSTER_TYPE = { WSFC | EXTERNAL | NONE } ) ]

# CASE JOIN_DISTRIBUTED
ALTER AVAILABILITY GROUP name JOIN AVAILABILITY GROUP ON distributed_group_definition , distributed_group_definition

# CASE MODIFY_DISTRIBUTED
ALTER AVAILABILITY GROUP name MODIFY AVAILABILITY GROUP ON distributed_modify_definition [, ...]

# CASE GRANT
ALTER AVAILABILITY GROUP name GRANT CREATE ANY DATABASE

# CASE DENY
ALTER AVAILABILITY GROUP name DENY CREATE ANY DATABASE

# CASE FAILOVER
ALTER AVAILABILITY GROUP name FAILOVER

# CASE FORCE_FAILOVER
ALTER AVAILABILITY GROUP name FORCE_FAILOVER_ALLOW_DATA_LOSS

# CASE OFFLINE
ALTER AVAILABILITY GROUP name OFFLINE

# CASE ADD_LISTENER
ALTER AVAILABILITY GROUP name ADD LISTENER 'dns_name' ( listener_definition )

# CASE MODIFY_LISTENER
ALTER AVAILABILITY GROUP name MODIFY LISTENER 'dns_name'
    ( { ADD IP ( ip_definition ) | PORT = port | REMOVE IP ( 'ip_address' ) } )

# CASE RESTART_LISTENER
ALTER AVAILABILITY GROUP name RESTART LISTENER 'dns_name'

# CASE REMOVE_LISTENER
ALTER AVAILABILITY GROUP name REMOVE LISTENER 'dns_name'

# ONEOFIS availability_option
AUTOMATED_BACKUP_PREFERENCE = { PRIMARY | SECONDARY_ONLY | SECONDARY | NONE }
FAILURE_CONDITION_LEVEL = { 1 | 2 | 3 | 4 | 5 }
HEALTH_CHECK_TIMEOUT = milliseconds
DB_FAILOVER = { ON | OFF }
DTC_SUPPORT = { PER_DB | NONE }
REQUIRED_SYNCHRONIZED_SECONDARIES_TO_COMMIT = secondary_count
ROLE = SECONDARY
CLUSTER_CONNECTION_OPTIONS = 'connection_options'

# ONEOFIS replica_modify_option
ENDPOINT_URL = 'endpoint_url'
AVAILABILITY_MODE = { SYNCHRONOUS_COMMIT | ASYNCHRONOUS_COMMIT }
FAILOVER_MODE = { AUTOMATIC | MANUAL | EXTERNAL }
SEEDING_MODE = { AUTOMATIC | MANUAL }
BACKUP_PRIORITY = priority_value
SECONDARY_ROLE ( { ALLOW_CONNECTIONS = { NO | READ_ONLY | ALL } | READ_ONLY_ROUTING_URL = { 'routing_url' | NONE } } )
PRIMARY_ROLE ( { ALLOW_CONNECTIONS = { READ_WRITE | ALL } | READ_ONLY_ROUTING_LIST = { ( routing_target [, ...] ) | NONE } | READ_WRITE_ROUTING_URL = { 'routing_url' | NONE } } )
SESSION_TIMEOUT = seconds

# WHERE distributed_modify_definition
availability_group WITH ( distributed_modify_option )

# ONEOFIS distributed_modify_option
LISTENER = 'listener_url'
AVAILABILITY_MODE = { SYNCHRONOUS_COMMIT | ASYNCHRONOUS_COMMIT }
SEEDING_MODE = { AUTOMATIC | MANUAL }


# PARTOFIS replica_definition
'server_instance' WITH (
    ENDPOINT_URL = 'endpoint_url' ,
    AVAILABILITY_MODE = { SYNCHRONOUS_COMMIT | ASYNCHRONOUS_COMMIT } ,
    FAILOVER_MODE = { AUTOMATIC | MANUAL | EXTERNAL }
    [ , replica_option [, ...] ]
)

'server_instance' WITH (
    ENDPOINT_URL = 'endpoint_url' ,
    AVAILABILITY_MODE = CONFIGURATION_ONLY
)

# ONEOFIS replica_option
SEEDING_MODE = { AUTOMATIC | MANUAL }
BACKUP_PRIORITY = priority_value
SECONDARY_ROLE ( secondary_role_option [, ...] )
PRIMARY_ROLE ( primary_role_option [, ...] )
SESSION_TIMEOUT = seconds

# ONEOFIS secondary_role_option
ALLOW_CONNECTIONS = { NO | READ_ONLY | ALL }
READ_ONLY_ROUTING_URL = 'routing_url'

# ONEOFIS primary_role_option
ALLOW_CONNECTIONS = { READ_WRITE | ALL }
READ_ONLY_ROUTING_LIST = { ( routing_target [, ...] ) | NONE }
READ_WRITE_ROUTING_URL = 'routing_url'

# ONEOFIS routing_target
'server_instance'
( 'server_instance' [, ...] )

# WHERE distributed_group_definition
availability_group WITH (
    LISTENER_URL = 'listener_url' ,
    AVAILABILITY_MODE = { SYNCHRONOUS_COMMIT | ASYNCHRONOUS_COMMIT } ,
    FAILOVER_MODE = MANUAL ,
    SEEDING_MODE = { AUTOMATIC | MANUAL }
)

# ONEOFIS listener_definition
WITH DHCP [ ON ( 'ipv4_address' , 'ipv4_mask' ) ]
WITH IP ( ( ip_definition ) [, ...] ) [ , PORT = port ]

# ONEOFIS ip_definition
'ipv4_address' , 'ipv4_mask'
'ipv6_address'
