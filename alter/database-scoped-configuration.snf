# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-database-scoped-configuration-transact-sql?view=sql-server-ver17

# CASE SET
ALTER DATABASE SCOPED CONFIGURATION SET configuration_option

# CASE SECONDARY
ALTER DATABASE SCOPED CONFIGURATION FOR SECONDARY SET secondary_configuration_option

# CASE CLEAR_CACHE
ALTER DATABASE SCOPED CONFIGURATION CLEAR PROCEDURE_CACHE [ plan_handle ]


# ONEOFIS configuration_option
ACCELERATED_PLAN_FORCING = { ON | OFF }
ASYNC_STATS_UPDATE_WAIT_AT_LOW_PRIORITY = { ON | OFF }
BATCH_MODE_ADAPTIVE_JOINS = { ON | OFF }
BATCH_MODE_MEMORY_GRANT_FEEDBACK = { ON | OFF }
BATCH_MODE_ON_ROWSTORE = { ON | OFF }
CE_FEEDBACK = { ON | OFF }
DEFERRED_COMPILATION_TV = { ON | OFF }
DOP_FEEDBACK = { ON | OFF }
EXEC_QUERY_STATS_FOR_SCALAR_FUNCTIONS = { ON | OFF }
FORCE_SHOWPLAN_RUNTIME_PARAMETER_COLLECTION = { ON | OFF }
IDENTITY_CACHE = { ON | OFF }
INTERLEAVED_EXECUTION_TVF = { ON | OFF }
ISOLATE_SECURITY_POLICY_CARDINALITY = { ON | OFF }
GLOBAL_TEMPORARY_TABLE_AUTO_DROP = { ON | OFF }
LAST_QUERY_PLAN_STATS = { ON | OFF }
LIGHTWEIGHT_QUERY_PROFILING = { ON | OFF }
MEMORY_GRANT_FEEDBACK_PERCENTILE_GRANT = { ON | OFF }
MEMORY_GRANT_FEEDBACK_PERSISTENCE = { ON | OFF }
OPTIMIZE_FOR_AD_HOC_WORKLOADS = { ON | OFF }
OPTIMIZED_PLAN_FORCING = { ON | OFF }
OPTIMIZED_SP_EXECUTESQL = { ON | OFF }
OPTIONAL_PARAMETER_OPTIMIZATION = { ON | OFF }
PARAMETER_SENSITIVE_PLAN_OPTIMIZATION = { ON | OFF }
ROW_MODE_MEMORY_GRANT_FEEDBACK = { ON | OFF }
TSQL_SCALAR_UDF_INLINING = { ON | OFF }
VERBOSE_TRUNCATION_WARNINGS = { ON | OFF }
LEGACY_CARDINALITY_ESTIMATION = { ON | OFF }
PARAMETER_SNIFFING = { ON | OFF }
QUERY_OPTIMIZER_HOTFIXES = { ON | OFF }
READABLE_SECONDARY_TEMPORARY_STATS_AUTO_CREATE = { ON | OFF }
READABLE_SECONDARY_TEMPORARY_STATS_AUTO_UPDATE = { ON | OFF }
ELEVATE_ONLINE = { OFF | WHEN_SUPPORTED | FAIL_UNSUPPORTED }
ELEVATE_RESUMABLE = { OFF | WHEN_SUPPORTED | FAIL_UNSUPPORTED }
FULLTEXT_INDEX_VERSION = { 1 | 2 }
MAXDOP = maxdop
PAUSED_RESUMABLE_INDEX_ABORT_DURATION_MINUTES = minutes
LEDGER_DIGEST_STORAGE_ENDPOINT = { 'endpoint_url' | OFF }

# ONEOFIS secondary_configuration_option
LEGACY_CARDINALITY_ESTIMATION = { ON | OFF | PRIMARY }
PARAMETER_SNIFFING = { ON | OFF | PRIMARY }
QUERY_OPTIMIZER_HOTFIXES = { ON | OFF | PRIMARY }
READABLE_SECONDARY_TEMPORARY_STATS_AUTO_CREATE = { ON | OFF | PRIMARY }
READABLE_SECONDARY_TEMPORARY_STATS_AUTO_UPDATE = { ON | OFF | PRIMARY }
MAXDOP = { maxdop | PRIMARY }
