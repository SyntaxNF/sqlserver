# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-server-role-transact-sql?view=sql-server-ver17

# CASE ADD_MEMBER
ALTER SERVER ROLE name ADD MEMBER server_principal

# CASE DROP_MEMBER
ALTER SERVER ROLE name DROP MEMBER server_principal

# CASE RENAME
ALTER SERVER ROLE name WITH NAME = new_role_name
