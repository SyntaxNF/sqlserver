# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-trigger-transact-sql?view=sql-server-ver17

# CASE DML_TSQL
ALTER TRIGGER name ON table
    [ WITH { ENCRYPTION | dml_execute_as_clause } [, ...] ]
    { FOR | AFTER | INSTEAD OF } dml_event [, ...]
    [ NOT FOR REPLICATION ]
    AS sql_statement_list

# CASE DML_CLR
ALTER TRIGGER name ON table
    [ WITH dml_execute_as_clause ]
    { FOR | AFTER | INSTEAD OF } dml_event [, ...]
    [ NOT FOR REPLICATION ]
    AS EXTERNAL NAME assembly . class_name . method_name

# CASE DATABASE_DDL_TSQL
ALTER TRIGGER name ON DATABASE
    [ WITH { ENCRYPTION | database_execute_as_clause } [, ...] ]
    { FOR | AFTER } ddl_event [, ...]
    AS sql_statement_list

# CASE DATABASE_DDL_CLR
ALTER TRIGGER name ON DATABASE
    [ WITH database_execute_as_clause ]
    { FOR | AFTER } ddl_event [, ...]
    AS EXTERNAL NAME assembly . class_name . method_name

# CASE SERVER_DDL_TSQL
ALTER TRIGGER name ON ALL SERVER
    [ WITH { ENCRYPTION | server_execute_as_clause } [, ...] ]
    { FOR | AFTER } ddl_event [, ...]
    AS sql_statement_list

# CASE SERVER_DDL_CLR
ALTER TRIGGER name ON ALL SERVER
    [ WITH server_execute_as_clause ]
    { FOR | AFTER } ddl_event [, ...]
    AS EXTERNAL NAME assembly . class_name . method_name

# CASE LOGON_TSQL
ALTER TRIGGER name ON ALL SERVER
    [ WITH { ENCRYPTION | server_execute_as_clause } [, ...] ]
    { FOR | AFTER } LOGON
    AS sql_statement_list

# CASE LOGON_CLR
ALTER TRIGGER name ON ALL SERVER
    [ WITH server_execute_as_clause ]
    { FOR | AFTER } LOGON
    AS EXTERNAL NAME assembly . class_name . method_name

# CASE NATIVE_DML
ALTER TRIGGER name ON table
    WITH NATIVE_COMPILATION , SCHEMABINDING , dml_execute_as_clause
    { FOR | AFTER } dml_event [, ...]
    AS BEGIN ATOMIC WITH ( atomic_option [, ...] )
        sql_statement_list
    END

# WHERE dml_event
{ INSERT | UPDATE | DELETE }

# WHERE dml_execute_as_clause
{ EXEC | EXECUTE } AS { CALLER | SELF | OWNER | 'user_name' }

# WHERE database_execute_as_clause
{ EXEC | EXECUTE } AS { CALLER | SELF | 'user_name' }

# WHERE server_execute_as_clause
{ EXEC | EXECUTE } AS { CALLER | SELF | 'login_name' }

# ONEOFIS atomic_option
LANGUAGE = [ N ] 'language'
TRANSACTION ISOLATION LEVEL = { SNAPSHOT | REPEATABLE READ | SERIALIZABLE }
DATEFIRST = datefirst_value
DATEFORMAT = dateformat_value
DELAYED_DURABILITY = { ON | OFF }
