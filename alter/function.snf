# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-function-transact-sql?view=sql-server-ver17

# CASE SCALAR
ALTER FUNCTION name ( [ parameter_definition [, ...] ] )
    RETURNS data_type
    [ WITH scalar_option [, ...] ]
    [ AS ]
    BEGIN
        [ sql_statement_list ]
        RETURN value_expression
    END

# CASE INLINE_TABLE
ALTER FUNCTION name ( [ parameter_definition [, ...] ] )
    RETURNS TABLE
    [ WITH inline_option [, ...] ]
    [ AS ]
    RETURN { query_statement | ( query_statement ) }

# CASE MULTISTATEMENT_TABLE
ALTER FUNCTION name ( [ parameter_definition [, ...] ] )
    RETURNS return_variable TABLE ( table_element_definition [, ...] )
    [ WITH table_function_option [, ...] ]
    [ AS ]
    BEGIN
        [ sql_statement_list ]
        RETURN
    END

# CASE CLR_SCALAR
ALTER FUNCTION name ( [ clr_parameter_definition [, ...] ] )
    RETURNS data_type
    [ WITH clr_scalar_option [, ...] ]
    [ AS ]
    EXTERNAL NAME assembly . class_name . method_name

# CASE CLR_TABLE
ALTER FUNCTION name ( [ clr_parameter_definition [, ...] ] )
    RETURNS TABLE ( clr_column_definition [, ...] )
    [ WITH execute_as_clause ]
    [ ORDER ( order_column_definition [, ...] ) ]
    [ AS ]
    EXTERNAL NAME assembly . class_name . method_name

# CASE NATIVE_SCALAR
ALTER FUNCTION name ( [ native_parameter_definition [, ...] ] )
    RETURNS data_type
    WITH NATIVE_COMPILATION , SCHEMABINDING , execute_as_clause
        [ , { RETURNS NULL ON NULL INPUT | CALLED ON NULL INPUT } ]
    [ AS ] BEGIN ATOMIC WITH ( atomic_option [, ...] )
        [ sql_statement_list ]
        RETURN value_expression
    END

# WHERE parameter_definition
parameter [ AS ] data_type
    [ = default_value ]
    [ READONLY ]

# WHERE native_parameter_definition
parameter [ AS ] data_type
    [ NULL | NOT NULL ]
    [ = default_value ]
    [ READONLY ]

# WHERE clr_parameter_definition
parameter [ AS ] data_type [ = default_value ]

# WHERE scalar_option
{
    ENCRYPTION |
    SCHEMABINDING |
    RETURNS NULL ON NULL INPUT |
    CALLED ON NULL INPUT |
    execute_as_clause |
    INLINE = { ON | OFF }
}

# WHERE inline_option
{ ENCRYPTION | SCHEMABINDING }

# WHERE table_function_option
{ ENCRYPTION | SCHEMABINDING | execute_as_clause }

# WHERE clr_scalar_option
{ RETURNS NULL ON NULL INPUT | CALLED ON NULL INPUT | execute_as_clause }

# WHERE clr_column_definition
colname data_type

# WHERE order_column_definition
colname [ ASC | DESC ]

# WHERE execute_as_clause
EXECUTE AS { CALLER | SELF | OWNER | 'user_name' }

# ONEOFIS atomic_option
LANGUAGE = [ N ] 'language'
TRANSACTION ISOLATION LEVEL = { SNAPSHOT | REPEATABLE READ | SERIALIZABLE }
DATEFIRST = datefirst_value
DATEFORMAT = dateformat_value
DELAYED_DURABILITY = { ON | OFF }

# STATEMENT query_statement
SELECT

# PARTOFIS table_element_definition
colname data_type [ COLLATE collation ]
    [ DEFAULT default_expression | IDENTITY [ ( seed_value , increment_value ) ] ]
    [ ROWGUIDCOL ] [ NULL | NOT NULL ] [ column_constraint_definition [...] ]

colname AS computed_expression

{ PRIMARY KEY | UNIQUE } [ CLUSTERED | NONCLUSTERED ]
    ( index_column_definition [, ...] ) [ WITH ( table_index_option [, ...] ) ]

CHECK ( boolean_expression )

# WHERE column_constraint_definition
{
    { PRIMARY KEY | UNIQUE } [ CLUSTERED | NONCLUSTERED ] [ WITH ( table_index_option [, ...] ) ] |
    CHECK ( boolean_expression )
}

# WHERE index_column_definition
colname [ ASC | DESC ]

# ONEOFIS table_index_option
PAD_INDEX = { ON | OFF }
FILLFACTOR = fillfactor_value
IGNORE_DUP_KEY = { ON | OFF }
STATISTICS_NORECOMPUTE = { ON | OFF }
ALLOW_ROW_LOCKS = { ON | OFF }
ALLOW_PAGE_LOCKS = { ON | OFF }
