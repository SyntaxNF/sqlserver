# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-fulltext-stoplist-transact-sql?view=sql-server-ver17

# CASE ADD
ALTER FULLTEXT STOPLIST name ADD stopword_literal LANGUAGE language_term

# CASE DROP_WORD
ALTER FULLTEXT STOPLIST name DROP stopword_literal LANGUAGE language_term

# CASE DROP_ALL
ALTER FULLTEXT STOPLIST name DROP ALL [ LANGUAGE language_term ]
