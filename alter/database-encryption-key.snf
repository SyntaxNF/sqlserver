# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-database-encryption-key-transact-sql?view=sql-server-ver17

# CASE REGENERATE
ALTER DATABASE ENCRYPTION KEY REGENERATE WITH ALGORITHM = { AES_128 | AES_192 | AES_256 }

# CASE ENCRYPTOR
ALTER DATABASE ENCRYPTION KEY ENCRYPTION BY SERVER
    { CERTIFICATE certificate_name | ASYMMETRIC KEY asymmetric_key_name }
