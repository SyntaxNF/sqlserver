# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-server-audit-specification-transact-sql?view=sql-server-ver17

# CASE AUDIT_BINDING
ALTER SERVER AUDIT SPECIFICATION name FOR SERVER AUDIT audit_name
    [ audit_specification_action [, ...] ]
    [ WITH ( STATE = { ON | OFF } ) ]

# CASE ACTIONS
ALTER SERVER AUDIT SPECIFICATION name audit_specification_action [, ...]
    [ WITH ( STATE = { ON | OFF } ) ]

# CASE STATE
ALTER SERVER AUDIT SPECIFICATION name WITH ( STATE = { ON | OFF } )

# WHERE audit_specification_action
{ ADD | DROP } ( server_audit_action_group )
