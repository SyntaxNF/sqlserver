# https://learn.microsoft.com/en-us/sql/t-sql/statements/alter-sequence-transact-sql?view=sql-server-ver17

# CASE SEQUENCE
ALTER SEQUENCE name
    [ RESTART [ WITH restart_value ] ]
    [ INCREMENT BY increment_value ]
    [ MINVALUE minimum_value | NO MINVALUE ]
    [ MAXVALUE maximum_value | NO MAXVALUE ]
    [ CYCLE | NO CYCLE ]
    [ CACHE [ cache_value ] | NO CACHE ]
