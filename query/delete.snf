# https://learn.microsoft.com/en-us/sql/t-sql/statements/delete-transact-sql?view=sql-server-ver17

# CASE DELETE
[ WITH cte_definition [, ...] ]
DELETE [ TOP ( row_count_expression ) [ PERCENT ] ] [ FROM ] delete_target
    [ output_clause ]
    [ FROM from_expression [, ...] ]
    [ WHERE boolean_expression ]

# WHERE output_clause
{
    OUTPUT output_item [, ...] |
    OUTPUT output_item [, ...] INTO output_target [ ( colname [, ...] ) ]
        [ OUTPUT output_item [, ...] ]
}

# WHERE output_item
{ DELETED . * | { DELETED . colname | output_expression } [ [ AS ] col_alias ] }

# WHERE cte_definition
cte [ ( colname [, ...] ) ] AS ( query_statement )

# STATEMENT query_statement
SELECT
