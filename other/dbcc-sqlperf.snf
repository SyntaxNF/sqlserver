# https://learn.microsoft.com/en-us/sql/t-sql/database-console-commands/dbcc-sqlperf-transact-sql?view=sql-server-ver17

# CASE LOGSPACE
DBCC SQLPERF ( LOGSPACE ) [ WITH NO_INFOMSGS ]

# CASE CLEAR
DBCC SQLPERF ( { "SYS.DM_OS_LATCH_STATS" | "SYS.DM_OS_WAIT_STATS" } , CLEAR )
    [ WITH NO_INFOMSGS ]
