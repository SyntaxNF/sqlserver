# https://learn.microsoft.com/en-us/sql/t-sql/statements/grant-transact-sql?view=sql-server-ver17

# CASE SERVER_OR_DATABASE_SCOPE
GRANT permission_name [, ...]
    TO principal_name [, ...] [ WITH GRANT OPTION ] [ AS grantor_principal ]

# CASE DATABASE_ALL
GRANT ALL [ PRIVILEGES ]
    TO database_principal [, ...] [ WITH GRANT OPTION ] [ AS grantor_principal ]

# CASE OBJECT_SCOPE
GRANT object_permission [, ...]
    ON [ OBJECT :: ] object_name [ ( column_name [, ...] ) ]
    TO database_principal [, ...] [ WITH GRANT OPTION ] [ AS grantor_principal ]

# CASE NAMED_SECURABLE
GRANT permission_name [, ...]
    ON securable_class :: securable_name
    TO principal_name [, ...] [ WITH GRANT OPTION ] [ AS grantor_principal ]

# CASE SYSTEM_OBJECT
GRANT { SELECT | EXECUTE } ON [ SYS . ] system_object_name TO principal_name

# WHERE object_permission
{ ALL [ PRIVILEGES ] | permission_name [ ( column_name [, ...] ) ] }


# ONEOFIS securable_class
APPLICATION ROLE
ASSEMBLY
ASYMMETRIC KEY
AVAILABILITY GROUP
CERTIFICATE
CONTRACT
DATABASE SCOPED CREDENTIAL
ENDPOINT
EXTERNAL LANGUAGE
EXTERNAL MODEL
