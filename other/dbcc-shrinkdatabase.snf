# https://learn.microsoft.com/en-us/sql/t-sql/database-console-commands/dbcc-shrinkdatabase-transact-sql?view=sql-server-ver17

DBCC SHRINKDATABASE ( { database | database_id | 0 } [ , target_percent ] [ , { NOTRUNCATE | TRUNCATEONLY } ] )
    [ WITH shrink_option [, ...] ]

# ONEOFIS shrink_option
WAIT_AT_LOW_PRIORITY [ ( ABORT_AFTER_WAIT = { SELF | BLOCKERS } ) ]
NO_INFOMSGS
