# https://learn.microsoft.com/en-us/sql/t-sql/statements/set-statements-transact-sql?view=sql-server-ver17

# CASE BOOLEAN_OPTIONS
SET boolean_option [, ...] { ON | OFF }

# CASE SHOWPLAN
SET { SHOWPLAN_ALL | SHOWPLAN_TEXT | SHOWPLAN_XML } { ON | OFF }

# CASE STATISTICS
SET STATISTICS { IO | PROFILE | TIME | XML } { ON | OFF }

# CASE IDENTITY_INSERT
SET IDENTITY_INSERT table { ON | OFF }

# CASE DATEFIRST
SET DATEFIRST datefirst_value

# CASE DATEFORMAT
SET DATEFORMAT dateformat_value

# CASE LANGUAGE
SET LANGUAGE language_value

# CASE DEADLOCK_PRIORITY
SET DEADLOCK_PRIORITY { LOW | NORMAL | HIGH | priority_value }

# CASE LOCK_TIMEOUT
SET LOCK_TIMEOUT timeout_value

# CASE ROWCOUNT
SET ROWCOUNT rowcount_value

# CASE TEXTSIZE
SET TEXTSIZE size_value

# CASE QUERY_GOVERNOR_COST_LIMIT
SET QUERY_GOVERNOR_COST_LIMIT cost_value

# CASE FIPS_FLAGGER
SET FIPS_FLAGGER { 'ENTRY' | 'FULL' | 'INTERMEDIATE' | 'OFF' | OFF }

# CASE OFFSETS
SET OFFSETS offset_keyword [, ...] { ON | OFF }

# CASE CONTEXT_INFO
SET CONTEXT_INFO { binary_value | binary_variable }

# WHERE offset_keyword
{ SELECT | FROM | ORDER | TABLE | PROCEDURE | STATEMENT | PARAM | EXECUTE }

# WHERE boolean_option
{
    ANSI_DEFAULTS |
    ANSI_NULL_DFLT_OFF |
    ANSI_NULL_DFLT_ON |
    ANSI_NULLS |
    ANSI_PADDING |
    ANSI_WARNINGS |
    ARITHABORT |
    ARITHIGNORE |
    CONCAT_NULL_YIELDS_NULL |
    CURSOR_CLOSE_ON_COMMIT |
    FMTONLY |
    FORCEPLAN |
    IMPLICIT_TRANSACTIONS |
    NOCOUNT |
    NOEXEC |
    NUMERIC_ROUNDABORT |
    PARSEONLY |
    QUOTED_IDENTIFIER |
    REMOTE_PROC_TRANSACTIONS |
    XACT_ABORT
}
