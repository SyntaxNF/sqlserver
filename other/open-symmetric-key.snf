# https://learn.microsoft.com/en-us/sql/t-sql/statements/open-symmetric-key-transact-sql?view=sql-server-ver17

# CASE SYMMETRIC_KEY
OPEN SYMMETRIC KEY name DECRYPTION BY key_decryptor


# ONEOFIS key_decryptor
CERTIFICATE certificate_name [ WITH PASSWORD = 'password' ]
ASYMMETRIC KEY asymmetric_key_name [ WITH PASSWORD = 'password' ]
SYMMETRIC KEY symmetric_key_name
PASSWORD = 'password'
