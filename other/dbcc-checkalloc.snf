# https://learn.microsoft.com/en-us/sql/t-sql/database-console-commands/dbcc-checkalloc-transact-sql?view=sql-server-ver17

DBCC CHECKALLOC
    [ ( { database | database_id | 0 } [ , { NOINDEX | REPAIR_ALLOW_DATA_LOSS | REPAIR_FAST | REPAIR_REBUILD } ] ) ]
    [ WITH check_option [, ...] ]

# ONEOFIS check_option
ALL_ERRORMSGS
NO_INFOMSGS
TABLOCK
ESTIMATEONLY
