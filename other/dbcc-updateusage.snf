# https://learn.microsoft.com/en-us/sql/t-sql/database-console-commands/dbcc-updateusage-transact-sql?view=sql-server-ver17

DBCC UPDATEUSAGE ( { database | database_id | 0 } [ , { table | table_id | view | view_id } [ , { index | index_id } ] ] )
    [ WITH usage_option [, ...] ]

# ONEOFIS usage_option
NO_INFOMSGS
COUNT_ROWS
