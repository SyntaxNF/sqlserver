# https://learn.microsoft.com/en-us/sql/t-sql/database-console-commands/dbcc-shrinkfile-transact-sql?view=sql-server-ver17

# CASE SIZE
DBCC SHRINKFILE ( { file | file_id } [ , target_size ] [ , { NOTRUNCATE | TRUNCATEONLY } ] )
    [ WITH shrink_option [, ...] ]

# CASE EMPTY
DBCC SHRINKFILE ( { file | file_id } , EMPTYFILE ) [ WITH shrink_option [, ...] ]

# ONEOFIS shrink_option
WAIT_AT_LOW_PRIORITY [ ( ABORT_AFTER_WAIT = { SELF | BLOCKERS } ) ]
NO_INFOMSGS
